# 环境变量示例（复制为 .env 后填写真实值，.env 已在 .gitignore 中）

# 麦当劳 MCP Token（open.mcd.cn 控制台申请）
MCD_MCP_TOKEN=your_mcd_mcp_token_here

# 智谱 AI（用于微信自由问答与智能查价，可选）
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_MODEL=glm-5.3-flash

# 可选：数据库路径、扫描间隔（分钟）、Token 加密密钥（生产环境必须设置）
# WATCHDOG_DB=watchdog.db
# SCAN_INTERVAL_MINUTES=30
# WATCHDOG_FERNET_KEY=base64_32bytes_key
# 管理台口令（/admin?key=xxx 查看统计，生产必须设置）
# ADMIN_TOKEN=change_me
